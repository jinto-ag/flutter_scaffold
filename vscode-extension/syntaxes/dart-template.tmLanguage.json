{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dart Template",
  "scopeName": "source.dart.template",
  "patterns": [
    {
      "include": "#template-placeholder"
    },
    {
      "include": "source.dart"
    }
  ],
  "repository": {
    "template-placeholder": {
      "begin": "\\{\\{",
      "end": "\\}\\}",
      "name": "meta.embedded.template",
      "patterns": [
        {
          "match": "\\b(if\\s+[a-zA-Z0-9_]+|else\\s+if\\s+[a-zA-Z0-9_]+|else|endif)\\b",
          "name": "keyword.control.template"
        },
        {
          "match": "[a-zA-Z][a-zA-Z0-9_]*",
          "name": "variable.other.placeholder.template"
        }
      ]
    }
  }
}
