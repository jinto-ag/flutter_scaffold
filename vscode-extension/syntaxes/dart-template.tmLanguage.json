{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dart Template",
  "scopeName": "source.dart.template",
  "patterns": [
    {
      "include": "#template-placeholder"
    },
    {
      "include": "source.dart"
    }
  ],
  "repository": {
    "template-placeholder": {
      "name": "variable.other.placeholder.template",
      "match": "\\{\\{\\s*([a-zA-Z][a-zA-Z0-9_]*)\\s*\\}\\}",
      "captures": {
        "0": {
          "name": "punctuation.definition.placeholder.template"
        },
        "1": {
          "name": "variable.parameter.placeholder.template"
        }
      }
    }
  }
}
