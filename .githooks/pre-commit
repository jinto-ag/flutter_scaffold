#!/bin/bash
# Pre-commit hook for flutter_scaffold
# This hook runs before each commit to ensure code quality

set -e

echo "🔍 Running pre-commit checks..."

# 1. Run Dart analyzer
echo ""
echo "📊 Running Dart analyzer..."
if ! dart analyze; then
    echo "❌ Dart analyzer found issues. Please fix them before committing."
    exit 1
fi
echo "✅ Dart analyzer passed"

# 2. Run Dart format check
echo ""
echo "📝 Checking Dart formatting..."
if ! dart format --set-exit-if-changed --output=none lib/ bin/ test/ 2>/dev/null; then
    echo "❌ Some files need formatting. Run 'dart format .' to fix."
    exit 1
fi
echo "✅ Dart formatting passed"

# 3. Run tests
echo ""
echo "🧪 Running tests..."
if ! dart test --reporter compact; then
    echo "❌ Tests failed. Please fix them before committing."
    exit 1
fi
echo "✅ All tests passed"

# 4. Run E2E test (scaffold a project and verify)
# This is optional and can be skipped with SKIP_E2E=1
if [ "$SKIP_E2E" != "1" ]; then
    echo ""
    echo "🚀 Running E2E test..."
    if [ -f "scripts/e2e_test.sh" ]; then
        if ! ./scripts/e2e_test.sh; then
            echo "❌ E2E test failed. See e2e_test.log for details."
            exit 1
        fi
        echo "✅ E2E test passed"
    else
        echo "⚠️ E2E test script not found, skipping..."
    fi
else
    echo ""
    echo "⏭️ Skipping E2E test (SKIP_E2E=1)"
fi

echo ""
echo "✅ All pre-commit checks passed!"
